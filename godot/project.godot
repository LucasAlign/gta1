; Engine configuration file.
; Open this folder with Godot 4.x and use the Compatibility renderer for older hardware.

config_version=5

[application]
config/name="Grand Tractor Auto"
run/main_scene="res://scenes/phase1_fun_minute.tscn"
config/features=PackedStringArray("4.2")
config/icon="res://icon.svg"

[autoload]
GameState="*res://scripts/core/game_state.gd"

